<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps edge to edge; the web app and the setup screen are laid out for the classic bars. -->
    <style name="Theme.HaipCalls" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/haip_green</item>
        <item name="android:colorPrimaryDark">@color/haip_green_dark</item>
        <item name="android:colorAccent">@color/haip_green</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
