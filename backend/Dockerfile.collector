# The opt-in competitor collector (studio plan phase 2): same app code, plus instaloader, consuming ONLY the
# research_collect queue. Started only with `docker compose --profile research up -d research_collector`.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y gcc libpq-dev ffmpeg curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-collector.txt ./
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt -r requirements-collector.txt

COPY . .

CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--concurrency=1", "--queues=research_collect"]
