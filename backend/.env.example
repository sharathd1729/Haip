# HAIP Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# App
ENVIRONMENT=development
SECRET_KEY=REPLACE_ME_GENERATE_WITH_OPENSSL
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=https://your-api.haip.app

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/haip
REDIS_URL=redis://localhost:6379/0

# Object storage (AWS S3 or Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=haip-recordings
KMS_KEY_ID=
AWS_S3_ENDPOINT_URL=

# Encryption (Fernet key for credential storage)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# AI providers
LLM_PROVIDER=
TRANSCRIPTION_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# CallerDesk (Ratha)
CALLERDESK_API_KEY=
CALLERDESK_API_SECRET=
CALLERDESK_ACCOUNT_SID=
CALLERDESK_WEBHOOK_SECRET=

# Acefone (Jade)
ACEFONE_API_KEY=
ACEFONE_API_SECRET=
ACEFONE_WEBHOOK_SECRET=

# Dograh Voice AI
# Generate webhook secret: openssl rand -hex 32
DOGRAH_WEBHOOK_SECRET=REPLACE_ME_GENERATE_WITH_OPENSSL
DOGRAH_SERVER_URL=https://your-dograh-server.com
DOGRAH_AGENT_ID_DEFAULT=

# SIP / Telephony
# Dev: Twilio free trial (twilio.com, $15 credit, no credit card required)
# Prod: VoIP.ms or Plivo (cheaper per-minute rates in India)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp / Instagram (Meta)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_PAGE_ID=

# Email
RESEND_API_KEY=
EMAIL_FROM=notifications@haip.app

# Sentry
SENTRY_DSN=
SENTRY_RELEASE=

# Hostaway
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=
