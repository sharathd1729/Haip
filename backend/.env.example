# ════════════════════════════════════════════════════════════════════════════
#  HAIP Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to git.
# ════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-generate-32-random-chars
# Your frontend URL — used for invitation links and password reset emails
FRONTEND_URL=https://your-app.vercel.app

# ── Credential Encryption ─────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (Neon — free PostgreSQL + pgvector) ──────────────────────────
# Sign up: https://neon.tech → New project → copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/haip?sslmode=require

# ── Redis (Upstash — free tier) ───────────────────────────────────────────
# Sign up: https://upstash.com → Create Redis → copy REST URL
REDIS_URL=rediss://default:your-password@global-xxxx.upstash.io:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-random-64-char-hex-string-here

# ══════════════════════════════════════════════════════════════════════════════
#  AI PROVIDERS  — HAIP auto-selects based on which keys are present.
#  Priority: Groq (transcription) > Deepgram  |  Gemini (LLM) > Claude
# ══════════════════════════════════════════════════════════════════════════════

# Leave blank for auto-detect, or force: groq | deepgram | whisper
TRANSCRIPTION_PROVIDER=

# Leave blank for auto-detect, or force: gemini | claude
LLM_PROVIDER=

# ── OPTION A: Groq — FREE Whisper Large-v3 ───────────────────────────────────
# Free: 7,200 seconds audio/day  |  Sign up: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OPTION B: Google Gemini — FREE LLM ───────────────────────────────────────
# Free: 15 req/min, 1M tokens/day  |  Sign up: https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OPTION C: Anthropic Claude — PAID (upgrade later) ────────────────────────
# $5 free credit on new account  |  Sign up: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── OPTION D: Deepgram — PAID ($200 free credit) ─────────────────────────────
# Better speaker diarisation  |  Sign up: https://console.deepgram.com
DEEPGRAM_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
#  OBJECT STORAGE — Cloudflare R2 (FREE 10GB) or AWS S3
# ══════════════════════════════════════════════════════════════════════════════

# Sign up: https://cloudflare.com → R2 → Create bucket "haip-recordings"
# Then: R2 → Manage R2 API Tokens → Create token (read + write)
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_REGION=auto
S3_BUCKET_NAME=haip-recordings
KMS_KEY_ID=

# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Leave blank to use real AWS S3
AWS_S3_ENDPOINT_URL=https://xxxxxxxxxxxx.r2.cloudflarestorage.com

# ══════════════════════════════════════════════════════════════════════════════
#  IVR — CallerDesk (start KYC at callerdesk.io today — takes 1-2 days)
# ══════════════════════════════════════════════════════════════════════════════
CALLERDESK_API_KEY=
CALLERDESK_API_SECRET=
CALLERDESK_ACCOUNT_SID=
# Set the same string in CallerDesk dashboard → Webhooks → Secret
CALLERDESK_WEBHOOK_SECRET=pick-any-random-string

# Acefone (optional second provider)
ACEFONE_API_KEY=
ACEFONE_API_SECRET=
ACEFONE_WEBHOOK_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
#  WHATSAPP (skip for now — Meta approval takes 2-4 weeks)
# ══════════════════════════════════════════════════════════════════════════════
# Meta App credentials (used for WhatsApp AND Instagram Embedded Signup)
# Create app at: https://developers.facebook.com → My Apps → Create App → Business
META_APP_ID=
META_APP_SECRET=
# WhatsApp Embedded Signup config ID (from Facebook App → WhatsApp → Embedded Signup)
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Instagram Embedded Signup config ID (can reuse same config as WhatsApp)
META_INSTAGRAM_CONFIG_ID=
# Set this token in: Meta App → Webhooks → Verify Token (both WA + IG)
META_WEBHOOK_VERIFY_TOKEN=haip-webhook-verify-token
# Legacy direct token vars (only needed if NOT using Embedded Signup)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_PAGE_ID=

# ══════════════════════════════════════════════════════════════════════════════
#  EMAIL — Resend (3,000 free emails/month — add later)
#  Sign up: https://resend.com
# ══════════════════════════════════════════════════════════════════════════════
RESEND_API_KEY=
EMAIL_FROM=notifications@haip.app

# ══════════════════════════════════════════════════════════════════════════════
#  INTEGRATIONS (add as you reach each milestone)
# ══════════════════════════════════════════════════════════════════════════════
# ── RentalWise ───────────────────────────────────────────────────────────────
# Credentials provided by your RentalWise Engagement Manager (Basic Auth)
# Contact: support@rentalwise.com to get API access
RETALWISE_USERNAME=
RETALWISE_PASSWORD=
RETALWISE_BASE_URL=https://partners-api.rentalwise.com

# ── Hostaway ─────────────────────────────────────────────────────────────────
# Get from: Hostaway Dashboard → Settings → API Access
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_SECRET=

SENTRY_DSN=
