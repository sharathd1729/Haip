# Local test environment (docs/LOCAL_TESTING.md). scripts/local/start.ps1 copies this to backend/.env.local on first
# run and fills SECRET_KEY / ENCRYPTION_KEY with random values. backend/.env.local is git-ignored. The real backend/.env
# is never read by the local stack (HAIP_ENV_FILE points at .env.local).

# ── Paste your AI keys here (the only real services the local stack talks to) ──────────────────────────────────────
NVIDIA_API_KEY=
GEMINI_API_KEY=

# ── Everything below is local or fake. Leave as is. ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# WhatsApp, Instagram, Meta, Razorpay, email, IVR, push and R2/S3 are answered locally; see http://localhost:8000/dev/outbox
EXTERNAL_SERVICES=fake
LOCAL_DATA_DIR=
DATABASE_URL=postgresql://haip:haip@127.0.0.1:55432/haip_local
REDIS_URL=redis://127.0.0.1:56379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SECRET_KEY=__generated__
ENCRYPTION_KEY=__generated__
AUTH_SECRET=__generated__
# Ask HAIP free-form analyst: start.ps1 gives the local read-only role this password.
ANALYST_RO_DATABASE_URL=postgresql://haip_analyst_ro:haip_analyst_ro_local@127.0.0.1:55432/haip_local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
# Fake values so the send paths run end to end; the calls are intercepted, nothing reaches Resend or Meta.
RESEND_API_KEY=fake-local-resend-key
EMAIL_FROM=demo@wanderwheel.example
META_APP_SECRET=fake-local-meta-app-secret
S3_BUCKET_NAME=haip-local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
