# Environment of the opt-in competitor collector ONLY (docker-compose.prod.yml service research_collector).
# Copy to backend/.env.collector (git-ignored) and fill in. Keep it to exactly these: the collector fetches public
# pages and stores raw rows and media, nothing else.
#
# NEVER add: ENCRYPTION_KEY (it would let this container decrypt tenants' Instagram/WhatsApp/Meta tokens), the API's
# SECRET_KEY, META_*/WHATSAPP_*/INSTAGRAM_* tokens, GEMINI_API_KEY/NVIDIA_* (AI reading runs on the normal worker),
# RAZORPAY_*, RESEND_API_KEY, or anything else from backend/.env.

ENVIRONMENT=production
# Config refuses a weak key in production. Generate a NEW one for this container; never reuse the API's SECRET_KEY.
SECRET_KEY=
# Writes marketing_competitor_posts / marketing_signals and reads tenants + competitors.
DATABASE_URL=
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1
# Celery broker (the research_collect queue) and the follow-up task to the normal worker.
REDIS_URL=

# Egress for every collector request (residential/rotating proxy). Required: without it no source runs.
RESEARCH_PROXY_URL=
# Fallback when instaloader is blocked, and the Meta Ad Library.
APIFY_TOKEN=

# Storage for kept Reel copies (30 days). Use a separate IAM key allowed only s3:PutObject on this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
KMS_KEY_ID=
